# ==============================================================================
# CS HUB — Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Never commit real credentials or service-role keys to source control.
# - The frontend only needs the Supabase URL and the public Anonymous (Anon) Key.
# - Privileged administrative operations are protected via Supabase PostgreSQL RLS
#   and trusted server-side execution.
# ==============================================================================

# Public Supabase API credentials (safe for browser client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-example

# Application Metadata
VITE_APP_NAME="CS Hub"
VITE_APP_DESCRIPTION="The Independent Content Platform for Computer Science Students"
VITE_APP_URL=http://localhost:5173

# Optional: Demo/Local Mock Mode (fallback if Supabase credentials are not yet configured)
# Set to 'true' to allow exploring the UI with comprehensive mock data when DB credentials are absent
VITE_ENABLE_MOCK_FALLBACK=true
