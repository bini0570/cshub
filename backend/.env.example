# Railway PostgreSQL Database Connection URL (automatically provided by Railway when you attach a Postgres service)
DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway

# Server Port (Railway provides PORT automatically)
PORT=5000

# JSON Web Token Secret (generate any long random string)
JWT_SECRET=cshub_super_secret_jwt_key_railway_production_2026

# Telegram Bot Token (obtained from @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Vercel Frontend URL (used by Telegram Bot to create direct login links)
FRONTEND_URL=https://cshub-student.vercel.app
